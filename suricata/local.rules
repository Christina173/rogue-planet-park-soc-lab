# Rogue Planet Theme Park SOC
# Custom Suricata Detection Rules
#
# Lab network:
# Kali Linux test host: 192.168.56.20
# Ubuntu SOC server:     192.168.56.10
#
# All rules were created for controlled testing inside an isolated virtual lab.

# ICMP reconnaissance detection
alert icmp 192.168.56.20 any -> 192.168.56.10 any (msg:"ROGUE PLANET LAB - Kali ICMP Test"; itype:8; sid:1000001; rev:1;)

# TCP SYN reconnaissance detection
alert tcp 192.168.56.20 any -> 192.168.56.10 any (msg:"ROGUE PLANET LAB - Kali TCP Recon Test"; flags:S; sid:1000002; rev:1;)
